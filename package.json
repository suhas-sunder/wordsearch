{
  "name": "ilove-word-search",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate:search-index": "tsx scripts/generate-search-index.ts",
    "build": "npm run generate:search-index && next build",
    "start": "node tests/e2e/static-export-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:seo": "vitest run tests/seo",
    "audit:content": "vitest run tests/content/current-content-audit.test.ts --reporter=verbose",
    "audit:routes": "node tests/e2e/route-audit.mjs",
    "test:route-ad-contract": "vitest run tests/unit/ad-markup-contract.test.ts",
    "test:a11y": "node tests/e2e/accessibility.mjs",
    "audit:lighthouse": "node tests/e2e/lighthouse-audit.mjs",
    "audit:pdf": "node tests/e2e/pdf-visual-audit.mjs",
    "audit:static": "node tests/e2e/static-export-audit.mjs",
    "audit:static-host": "node tests/e2e/static-export-audit.mjs",
    "test:preview": "node tests/e2e/preview-toolbar.mjs",
    "test:directions": "node tests/e2e/direction-validation.mjs",
    "test:instructions": "node tests/e2e/printable-instructions.mjs",
    "test:inputs": "node tests/e2e/request-validation.mjs",
    "test:workload": "node tests/e2e/generation-workload.mjs",
    "test:parity": "node tests/e2e/share-route-parity.mjs",
    "test:transport": "tsx tests/e2e/share-transport-study.ts",
    "test:completion": "tsx tests/e2e/completion-card.ts",
    "test:e2e": "node tests/e2e/request-validation.mjs && node tests/e2e/direction-validation.mjs && node tests/e2e/browser-smoke.mjs && node tests/e2e/monetization-placeholders.mjs",
    "test:ads": "node tests/e2e/monetization-placeholders.mjs",
    "test:solver-progress": "tsx tests/e2e/solver-progress.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.29",
    "lighthouse": "^13.4.1",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
